---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import {
  projects,
  projectCount,
  projectCountLabel,
  projectFilters,
  filterCountLabel,
  type ProjectId,
} from '../data/projects';
import { expertise } from '../data/expertise';
import { githubRepositoriesUrl, githubUrl } from '../data/links';
import { formatProjectCount } from '../utils/format';
import { themes, type Theme } from '../data/themes';
import ProjectCard from './ProjectCard.astro';
import ProjectDialog from './ProjectDialog.astro';
import MotionToggle from './MotionToggle.astro';
interface Props {
  concept: Theme;
  demo?: boolean;
}
const { concept, demo = true } = Astro.props;
const type = concept.id;
const { hero, work, ticker, stamp } = concept;
const projectTitle = (id: ProjectId) =>
  projects.find((project) => project.id === id)?.title;
---

<Base title={`handism — ${concept.name}`} theme={type} noindex={demo}>
  <header class="site-header">
    <a class="wordmark" href={demo ? `/${type}/` : '/'}>
      handism<span>{concept.wordmarkMark}</span>
    </a>
    <nav aria-label="メインナビゲーション">
      <a href="#work">
        Work <sup>{projectCountLabel}</sup>
      </a>
      <a href="#about">About</a>
      <a href={githubUrl} target="_blank" rel="noreferrer">
        GitHub ↗
      </a>
    </nav>
    <span class="header-note mono">{concept.headerNote}</span>
  </header>
  <main id="main">
    <section class="hero">
      <div class="hero-topline mono">
        <span>
          <i class="status-dot"></i>
          {concept.status}
        </span>
        <span>BASED IN CURIOSITY</span>
      </div>
      <div class="hero-copy">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>
          {hero.title}
          <br />
          <em>{hero.titleEm}</em>
        </h1>
        <p class="hero-jp">{hero.jp}</p>
        <p class="hero-description">
          {hero.description.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
        <a class="hero-cta" href="#work">
          {hero.cta}
          <span>↘</span>
        </a>
      </div>
      <Art type={concept.art} hero />
      <div class="hero-bottom mono">
        <span>{hero.bottom}</span>
        <a href="#work">SCROLL TO EXPLORE ↓</a>
      </div>
      {stamp && (
        <span class="editorial-stamp">
          {stamp.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </span>
      )}
    </section>
    {ticker && (
      <div class="ticker" aria-hidden="true">
        <div>
          {Array.from({ length: 4 }, () => (
            <span>
              {ticker.map((phrase) => (
                <>
                  {phrase} <i>✳</i>{' '}
                </>
              ))}
            </span>
          ))}
        </div>
      </div>
    )}
    <section id="work" class="work section-wrap">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">
            {work.eyebrow} / 01—
            {projectCountLabel}
          </p>
          <h2>{work.title}</h2>
        </div>
        <p>
          つくるたび、少しずつ世界が広がる。
          <span class="visual-note">
            ※ 作品画像は、内容をイメージしたイラストです。
          </span>
        </p>
      </div>
      <div class="filter-row reveal">
        <div class="filters" role="group" aria-label="作品のカテゴリー">
          {projectFilters.map((filter, i) => (
            <button type="button" data-filter={filter} aria-pressed={i === 0}>
              {filter}
              <sup aria-hidden="true">{filterCountLabel(filter)}</sup>
            </button>
          ))}
        </div>
        <span class="mono result-count" aria-live="polite">
          {formatProjectCount(projectCount)}
        </span>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <a
        class="all-projects"
        href={githubRepositoriesUrl}
        target="_blank"
        rel="noreferrer"
      >
        <span>まだまだ、実験中。</span>すべてのリポジトリをGitHubで見る ↗
      </a>
    </section>
    <section id="about" class="about section-wrap">
      <div class="about-intro reveal">
        <p class="eyebrow">BEHIND THE WORK</p>
        <h2>
          It starts with
          <br />
          <em>“what if?”</em>
        </h2>
        <p class="about-lead">
          好きなことを、深く。
          <br />
          気になることを、まずつくる。
        </p>
        <p>
          サウナで過ごす時間も、メモを書く習慣も、
          <br class="desktop-only" />
          新しい技術への興味も。ものづくりの入口は、日常の中に。
        </p>
        <a href={githubUrl} target="_blank" rel="noreferrer">
          Meet me on GitHub ↗
        </a>
      </div>
      <div class="expertise reveal">
        <p class="eyebrow">MY TOOLBOX / 実績につながる技術</p>
        {expertise.map((item, i) => (
          <div class="expertise-row">
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.stack}</p>
              <small>{item.description}</small>
            </div>
            <button
              type="button"
              data-project={item.projectId}
              aria-label={`関連作品「${projectTitle(item.projectId)}」を見る`}
            >
              <span aria-hidden="true">→</span>
            </button>
          </div>
        ))}
      </div>
    </section>
    <footer class="site-footer section-wrap">
      <p class="eyebrow">THE NEXT IDEA IS ALREADY ON ITS WAY.</p>
      <a href={githubUrl} target="_blank" rel="noreferrer">
        Stay curious.<span>↗</span>
      </a>
      <div class="footer-bottom mono">
        <span>HANDISM © 2026</span>
        <span>MADE OF SMALL EXPERIMENTS</span>
        <a href="#main">BACK TO TOP ↑</a>
      </div>
    </footer>
  </main>
  {demo ? (
    <nav class="concept-switcher" aria-label="デザインデモの切り替え">
      <a class="switch-home" href="/concepts/" aria-label="3案の比較ページ">
        ◫ <span>比較</span>
      </a>
      <span class="switch-divider"></span>
      {themes.map((theme) => (
        <a
          href={`/${theme.id}/`}
          aria-current={type === theme.id ? 'page' : undefined}
        >
          <b>{theme.letter}</b>
          <span>{theme.name}</span>
        </a>
      ))}
      <MotionToggle />
    </nav>
  ) : (
    <MotionToggle standalone />
  )}
  {projects.map((project) => (
    <ProjectDialog project={project} />
  ))}
</Base>
