---
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<button
  type="button"
  class:list={['motion-toggle', { 'motion-standalone': standalone }]}
  aria-pressed="false"
  aria-label="動きを停止"
  title="アニメーションの停止・再開"
>
  <svg class="icon-pause" viewBox="0 0 12 12" aria-hidden="true">
    <rect x="2" y="1.5" width="2.6" height="9" rx="0.6"></rect>
    <rect x="7.4" y="1.5" width="2.6" height="9" rx="0.6"></rect>
  </svg>
  <svg class="icon-play" viewBox="0 0 12 12" aria-hidden="true">
    <path d="M3 1.6v8.8a.6.6 0 0 0 .9.5l7-4.4a.6.6 0 0 0 0-1L3.9 1.1a.6.6 0 0 0-.9.5Z"></path>
  </svg>
</button>
