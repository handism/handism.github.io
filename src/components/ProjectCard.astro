---
import Art from './Art.astro';
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="project reveal" data-category={project.filter}>
  <button
    class="project-visual"
    type="button"
    data-project={project.id}
    aria-label={`${project.title}の詳細を見る`}
  >
    <Art type={project.art} />
    <span class="visual-index mono">
      {project.number} / {project.category.toUpperCase()}
    </span>
    <span class="visual-open" aria-hidden="true">
      +
    </span>
  </button>
  <div class="project-content">
    <div class="project-title">
      <span class="project-number mono">/{project.number}</span>
      <!-- Mouse shortcut only; the visual button above is the keyboard entry point. -->
      <h3 data-project={project.id}>{project.title}</h3>
      <span class="project-category mono">{project.category}</span>
      {project.action && (
        <span class="project-badge mono">
          {project.action.kind === 'demo' ? 'LIVE DEMO' : 'DOWNLOAD'}
        </span>
      )}
    </div>
    <p class="project-ja">{project.ja}</p>
    <p class="project-description">{project.description}</p>
    <div class="project-stack">
      {project.stack.slice(0, 3).map((tech) => (
        <span>{tech}</span>
      ))}
    </div>
    <div class="project-links">
      <button
        class="project-more"
        type="button"
        data-project={project.id}
        tabindex="-1"
        aria-hidden="true"
      >
        Explore project <span>+</span>
      </button>
      {project.action && (
        <a
          class="project-action"
          href={project.action.href}
          target="_blank"
          rel="noreferrer"
        >
          {project.action.label} ↗
        </a>
      )}
    </div>
  </div>
</article>
